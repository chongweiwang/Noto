# Copy to .env and use existing absolute paths. Do not commit .env/passwords.
NOTO_IMAGE=noto:local
NOTO_VAULT_DIR=/srv/noto/vault
NOTO_DATA_DIR=/srv/noto/data
NOTO_PASSWORD_FILE=/srv/noto/password.txt
# Optional: allow passwords of at least 4 characters instead of the default 12.
NOTO_ALLOW_SHORT_PASSWORD=false
# Set to the uid/gid that can read/write the two mounted directories.
NOTO_UID=10001
NOTO_GID=10001
NOTO_BIND_IP=127.0.0.1
NOTO_PORT=3457
# For LAN/reverse proxy access, set the exact browser origin (no trailing slash).
NOTO_PUBLIC_ORIGIN=
# Optional local browser origin. Use auto for direct LAN HTTP by private IP.
NOTO_LOCAL_ORIGIN=
NOTO_SECURE_COOKIE=false
