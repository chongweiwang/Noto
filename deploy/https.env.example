# Linux/Docker paths. Use isolated directories for the first verification.
NOTO_IMAGE=noto:local
NOTO_VAULT_DIR=/srv/noto/vault
NOTO_DATA_DIR=/srv/noto/data
NOTO_PASSWORD_FILE=/srv/noto/password.txt
NOTO_TLS_DIR=/srv/noto/certificates
NOTO_UID=10001
NOTO_GID=10001
# Replace both addresses with the Docker host's actual LAN IP; no domain required.
NOTO_BIND_IP=192.168.1.10
NOTO_HTTPS_HOST=192.168.1.10
NOTO_HTTPS_PORT=38443
CADDY_IMAGE=caddy:2-alpine
