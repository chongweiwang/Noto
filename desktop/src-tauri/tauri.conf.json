{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noto",
  "version": "0.2.1",
  "identifier": "dev.noto.prototype",
  "build": {
    "beforeDevCommand": "npm run dev:next",
    "devUrl": "http://127.0.0.1:3456",
    "beforeBuildCommand": "npm run build:next",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      { "title": "Noto", "width": 1200, "height": 780, "minWidth": 720, "minHeight": 480, "dragDropEnabled": false }
    ]
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/32x32.png"] }
}

